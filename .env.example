# Database — Railway Postgres connection string
DATABASE_URL=

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Admin credentials for HTTP Basic Auth (both required, no fallback)
ADMIN_USER=
ADMIN_PASSWORD=

# Session secret for signed cookies
SESSION_SECRET=

# Transformers.js model cache (baked in at build time)
TRANSFORMERS_CACHE=./.cache/transformers
